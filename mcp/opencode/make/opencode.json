{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "make": {
        "type": "remote",
        "url": "{env:MAKE_MCP_URL}",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MAKE_MCP_TOKEN}"
        },
        "timeout": {
          "startup": 45000,
          "catalog": 60000,
          "execution": 120000
        }
      }
    }
  }
}
