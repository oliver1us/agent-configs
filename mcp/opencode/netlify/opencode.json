{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "netlify": {
        "type": "local",
        "command": ["npx", "-y", "@netlify/mcp"],
        "environment": {
          "NETLIFY_PERSONAL_ACCESS_TOKEN": "{env:NETLIFY_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  }
}
